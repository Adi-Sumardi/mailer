# Salin file ini jadi .env lalu isi sesuai domain kamu
MAIL_HOSTNAME=mail
MAIL_DOMAIN=domainanda.com

# Anti-spam & keamanan
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=1
ENABLE_CLAMAV=1
ENABLE_FAIL2BAN=1

# TLS — gunakan Let's Encrypt di production
SSL_TYPE=letsencrypt

# DKIM akan digenerate lewat perintah setup (lihat README mail-engine)
