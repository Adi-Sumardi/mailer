# Salin file ini jadi .env lalu isi sesuai domain kamu
MAIL_HOSTNAME=mail
MAIL_DOMAIN=domainanda.com

# Anti-spam & keamanan
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=1
ENABLE_CLAMAV=1
ENABLE_FAIL2BAN=1

# TLS — gunakan Let's Encrypt di production
SSL_TYPE=letsencrypt

# DKIM akan digenerate lewat perintah setup (lihat README mail-engine)

# ─── Ingest email masuk ke aplikasi ──────────────────────────────────────────────────────
# Email untuk domain tenant di-pipe ke skrip scripts/sendago-ingest.sh yang meneruskannya
# ke mail-app-service. Dua nilai ini WAJIB diisi, kalau tidak email masuk akan ter-defer
# (lihat config/postfix-main.cf: keduanya diteruskan ke skrip lewat export_environment).
SENDAGO_INGEST_URL=http://host.docker.internal:18002/emails/ingest
# HARUS SAMA PERSIS dengan INTERNAL_API_KEY di infra/.env (dipakai mail-app-service).
SENDAGO_INTERNAL_API_KEY=change-me-internal-key
