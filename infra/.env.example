POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
INTERNAL_API_KEY=change-me

# Kredensial akun mail-engine (Postfix/Dovecot) yang dipakai mail-app-service untuk
# submission SMTP (port 587). Buat akunnya dulu di mail-engine:
#   docker exec <container-mailserver> setup email add relay@yourdomain.com <password>
SMTP_USER=relay@yourdomain.com
SMTP_PASS=change-me

# IP publik VPS/mail-engine — dipakai domain-provisioning untuk merekomendasikan SPF record
# ("ip4:...") ke tenant yang menambahkan domain baru. WAJIB diisi benar di production.
OUTBOUND_RELAY_IP=change-me
