PORT=3002
DATABASE_URL="postgresql://sendagomail:sendagomail@localhost:5432/sendagomail_mail_app?schema=public"

# HARUS SAMA PERSIS dengan JWT_SECRET di services/auth-service (penerbit token).
JWT_SECRET=change-me-in-production

# HARUS SAMA PERSIS dengan INTERNAL_API_KEY di services/auth-service — melindungi
# POST /mailboxes (dipanggil auth-service saat provisioning end_user baru).
INTERNAL_API_KEY=change-me-internal-key

# FR-11a.2: durasi default delayed-send sebelum email ke penerima eksternal benar-benar
# dikirim lewat mail-engine. Rentang wajar sesuai SRS: 5-60 detik.
DEFAULT_RECALL_WINDOW_SECONDS=20

# Batas ukuran attachment (FR-09), dalam KB
MAX_ATTACHMENT_SIZE_KB=25600
