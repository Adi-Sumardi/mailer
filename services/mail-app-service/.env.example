PORT=3002
DATABASE_URL="postgresql://sendagomail:sendagomail@localhost:5432/sendagomail_mail_app?schema=public"

# HARUS SAMA PERSIS dengan JWT_SECRET di services/auth-service (penerbit token).
JWT_SECRET=change-me-in-production

# HARUS SAMA PERSIS dengan INTERNAL_API_KEY di services/auth-service — melindungi
# POST /mailboxes (dipanggil auth-service saat provisioning end_user baru).
INTERNAL_API_KEY=change-me-internal-key

# FR-11a.2: durasi default delayed-send sebelum email ke penerima eksternal benar-benar
# dikirim lewat mail-engine. Rentang wajar sesuai SRS: 5-60 detik.
DEFAULT_RECALL_WINDOW_SECONDS=5

# Batas ukuran attachment (FR-09), dalam KB
MAX_ATTACHMENT_SIZE_KB=25600

# Dipakai POST /emails/api-send untuk validasi member_id+secret & konsumsi kuota lewat
# auth-service (endpoint publik POST /auth/api-credentials/validate).
AUTH_SERVICE_URL=http://localhost:3000

# Direktori penyimpanan logo template branding per mailbox. Default relatif ke cwd kalau
# tidak diisi — di production WAJIB diarahkan ke volume yang persist (lihat infra/docker-compose.yml).
TEMPLATE_LOGOS_DIR=./template-logos

# ─── SMTP Relay (OPSIONAL) ───────────────────────────────────────────────────────────────
# Secara default SendagoMail Engine mengirim langsung ke MX server penerima (direct MX,
# port 25) tanpa relay eksternal — inilah mekanisme engine sendiri.
#
# Isi SMTP_HOST HANYA jika ingin menggunakan relay eksternal (Mailgun, SES, dsb.) sebagai
# override. Biarkan kosong untuk memakai direct MX delivery (default & direkomendasikan).
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
