PORT=3001
DATABASE_URL="postgresql://sendagomail:sendagomail@localhost:5432/sendagomail_domain_provisioning?schema=public"

# HARUS SAMA PERSIS dengan JWT_SECRET di services/auth-service (penerbit token).
JWT_SECRET=change-me-in-production

# HARUS SAMA PERSIS dengan INTERNAL_API_KEY di services/auth-service — dipakai untuk
# melindungi endpoint service-to-service (GET /internal/tenants/:id/exists).
INTERNAL_API_KEY=change-me-internal-key

# Lokasi direktori key DKIM yang dibaca mail-engine (docker-mailserver/OpenDKIM/Rspamd).
# Default relatif ke root repo: mail-engine/config/opendkim/keys
DKIM_KEYS_DIR=../../mail-engine/config/opendkim/keys

# Prefix pada TXT record verifikasi domain, contoh: sendagomail-verify=<token>
DOMAIN_VERIFICATION_TXT_PREFIX=sendagomail-verify

# Digunakan sebagai nilai default rekomendasi MX record (ganti sesuai mail-engine production)
MAIL_ENGINE_MX_HOST=mail.example.com
MAIL_ENGINE_MX_PRIORITY=10

# Digunakan untuk rekomendasi SPF record
OUTBOUND_RELAY_HOST=
