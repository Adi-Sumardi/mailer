generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConditionField {
  sender
  subject
  body
}

enum ConditionOperator {
  contains
  equals
}

enum ActionType {
  move_folder
  forward
  auto_reply
  delete
  ai_agent
}

enum AiProvider {
  openai
  anthropic
}

model AutomationRule {
  id     String @id @default(uuid()) @map("rule_id")
  userId String @map("user_id")

  name String

  // FR-19: kondisi — mis. "pengirim mengandung '@vendor.com'"
  conditionField    ConditionField
  conditionOperator ConditionOperator @default(contains) @map("condition_operator")
  conditionValue    String            @map("condition_value")

  // FR-19: aksi — mis. "pindahkan ke folder 'Vendor'". actionValue diinterpretasikan
  // sesuai actionType (nama folder / alamat forward / isi auto-reply, tidak dipakai untuk delete).
  actionType  ActionType @map("action_type")
  actionValue String?    @map("action_value")

  // Konfigurasi AI agent — hanya diisi kalau actionType = ai_agent. API key TIDAK PERNAH
  // disimpan plaintext (dienkripsi AES-256-GCM, lihat ai-key-crypto.util.ts) dan TIDAK PERNAH
  // dikembalikan mentah lewat API (lihat toPublic() di service). Eksekusi LLM sungguhan BELUM
  // diimplementasikan — lihat README, ini baru fondasi konfigurasi (FR terkait AI agent).
  aiProvider        AiProvider? @map("ai_provider")
  aiModel           String?     @map("ai_model")
  aiApiKeyEncrypted String?     @map("ai_api_key_encrypted")
  // Preview aman ditampilkan berulang di UI (mis. "sk-p...ab3x") — dihitung sekali saat
  // create/update, supaya tidak perlu dekripsi tiap kali list/GET rule ini.
  aiApiKeyMasked    String?     @map("ai_api_key_masked")

  // FR-21: aktif/nonaktifkan tanpa hapus
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("automation_rule")
}
