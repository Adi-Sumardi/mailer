PORT=3004
DATABASE_URL="postgresql://sendagomail:sendagomail@localhost:5432/sendagomail_automation?schema=public"

# HARUS SAMA PERSIS dengan JWT_SECRET di services/auth-service (penerbit token).
JWT_SECRET=change-me-in-production

# Dipakai untuk enkripsi (AES-256-GCM) API key AI agent milik tenant sebelum disimpan ke DB —
# TIDAK PERNAH sama dengan JWT_SECRET/INTERNAL_API_KEY supaya bisa dirotasi independen.
AI_KEY_ENCRYPTION_SECRET=change-me-in-production
