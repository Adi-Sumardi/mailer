generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  tenant_admin
  end_user
}

model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(end_user)

  // null untuk super_admin (tidak terikat satu tenant). Divalidasi best-effort ke
  // domain-provisioning saat register (fail-open kalau service itu tidak terjangkau) — lihat README.
  tenantId String? @map("tenant_id")

  // null sampai mailbox berhasil diprovisikan lewat mail-app-service (FR-07).
  mailboxId String? @map("mailbox_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("app_user")
}

model RefreshToken {
  id     String @id @default(uuid()) @map("refresh_token_id")
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  // Disimpan hash (SHA-256) — token mentah hanya pernah ada di response ke client sekali saja.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_token")
}

enum CredentialEnvironment {
  sandbox
  production
}

// Kredensial integrasi aplikasi eksternal (member_id + secret) — dipakai app pihak ketiga
// untuk otentikasi ke SendagoMail di luar alur login user biasa (JWT). Skoping per-tenant.
model ApiCredential {
  id       String @id @default(uuid()) @map("credential_id")
  tenantId String @map("tenant_id")
  name     String

  environment CredentialEnvironment @default(sandbox)

  // Identifier publik (aman ditampilkan berulang) vs secret (di-hash, hanya ditampilkan
  // mentah sekali saat dibuat — sama seperti pola refresh token).
  memberId   String @unique @map("member_id")
  secretHash String @map("secret_hash")

  // FR terkait paket berlangganan (belum ada sistem billing sungguhan — lihat README):
  // sandbox selalu dibatasi kuota kecil gratis; production pakai limit default sampai
  // nanti benar-benar terhubung ke paket tenant.
  dailyEmailLimit Int      @map("daily_email_limit")
  emailsSentToday Int      @default(0) @map("emails_sent_today")
  quotaResetAt    DateTime @default(now()) @map("quota_reset_at")

  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("api_credential")
}
