PORT=3000
DATABASE_URL="postgresql://sendagomail:sendagomail@localhost:5432/sendagomail_auth?schema=public"

# HARUS SAMA PERSIS dengan JWT_SECRET di domain-provisioning dan mail-app-service —
# auth-service adalah satu-satunya penerbit token, tapi ketiga service masih verifikasi
# pakai shared-secret manual sampai ada mekanisme JWKS/public-key.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Masa berlaku refresh token (hari). Dirotasi setiap dipakai — lihat AuthService.refresh().
REFRESH_TOKEN_DAYS=30

# HARUS SAMA PERSIS dengan INTERNAL_API_KEY di domain-provisioning dan mail-app-service —
# dipakai untuk endpoint service-to-service (provisioning mailbox, validasi tenantId).
INTERNAL_API_KEY=change-me-internal-key

# Dipanggil saat registrasi end_user untuk provisioning mailbox otomatis (FR-07).
# Kegagalan panggilan ini tidak menggagalkan registrasi — mailboxId akan null dan perlu
# provisioning ulang manual (lihat TODO di README).
MAIL_APP_SERVICE_URL=http://localhost:3002

# Dipanggil saat registrasi tenant_admin/end_user untuk validasi silang tenantId (BR-08).
# Kegagalan panggilan ini (service tidak terjangkau) tidak menggagalkan registrasi —
# fail-open, lihat AuthService.register().
DOMAIN_PROVISIONING_SERVICE_URL=http://localhost:3001
